# ============ 基础配置 ============
# 生产环境务必修改
SECRET_KEY=please-change-me-to-a-random-string
JWT_SECRET=please-change-me-to-another-random-string
JWT_EXPIRES_HOURS=168

# SQLite 默认写入 backend/instance/guiwei.db，可改为其他 SQLAlchemy 连接串
# DATABASE_URL=sqlite:///E:/data/guiwei.db

# 上传目录（默认 backend/uploads）
# UPLOAD_FOLDER=E:/data/guiwei-uploads
MAX_UPLOAD_MB=20

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 管理员 ============
# 首次启动 / 执行 init-db 时，若库中没有管理员则用此账号创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ============ DeepSeek 对话模型 ============
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# 可用模型：deepseek-flash、deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0
AI_MAX_ITERATIONS=8

# ============ 视觉识图（DeepSeek 多模态） ============
# deepseek-flash 已支持图片输入，默认复用上面的 DEEPSEEK_API_BASE / DEEPSEEK_API_KEY。
# 一般只需填写 DEEPSEEK_API_KEY；如需使用其它 OpenAI 兼容视觉网关，再覆盖以下配置。
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=deepseek-flash
VISION_TIMEOUT=120

# ============ 多物品检测（可选，YOLOE 开放词汇 + 实例分割） ============
# 需要先安装：pip install -r requirements-yolo.txt（会安装 ultralytics 与 torch）
# 首次检测会自动下载模型权重；未安装时「多物品识别」按钮会提示安装命令。
# 模型越大越准：yoloe-11m-seg.pt（更快）、yoloe-11l-seg.pt（默认）、yoloe-11x-seg.pt（最准）
YOLO_MODEL=yoloe-11l-seg.pt
# 模型与 CLIP 权重缓存目录（默认 backend/weights，首次运行自动下载）
YOLO_WEIGHTS_DIR=
# 开放词汇类别（英文，逗号分隔），已包含常见家居/收纳/洗漱物品；可按需增删
YOLO_CLASSES=bottle, jar, can, box, container, basket, bag, cup, bowl, plate, book, notebook, pen, scissors, tape, stapler, ruler, glue, calculator, remote, cell phone, tablet, laptop, keyboard, computer mouse, computer monitor, television, speaker, printer, router, game controller, camera, microphone, tripod, usb drive, external hard drive, power strip, charger, cable, power bank, headphones, key, wallet, umbrella, glasses, watch, towel, clothes, shoe, hat, toy, medicine bottle, medicine box, pill, blister pack, band-aid, ointment tube, cotton swab, thermometer, face mask, first aid kit, cosmetic bottle, perfume, toothbrush, toothpaste, soap, shampoo, tissue, snack, chopsticks, spoon, fork, knife, desk lamp, electric fan, clock, picture frame, vase, candle, lighter, battery, flashlight, hairdryer, clothes iron, razor, shaving cream, comb, hairbrush, body wash, face wash, hand sanitizer, mouthwash, dental floss, water flosser, deodorant, cotton pad, nail clippers, tweezers, makeup brush, lipstick, sunscreen, mirror, bathroom scale, loofah, soap dish, shower cap, toilet paper, washcloth, toothbrush holder, cosmetic bag
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
# 多物品照片物品小且密集，1280 比 640 明显更准；CPU 较慢时可降到 960/640
YOLO_IMAGE_SIZE=1280
YOLO_MAX_OBJECTS=12
# 切割后短边小于该像素的物品直接忽略（低于 64px 的缩略图意义不大）
YOLO_MIN_CROP_SIDE=64
# 裁切时向外扩展比例（0.06 = 6%），避免切掉物体边缘
YOLO_CROP_PADDING=0.06
# 跨类别 NMS：jar/can/bottle 语义重叠时去重；相邻物品多时保持 false
YOLO_AGNOSTIC_NMS=false
# 未入库的检测裁切图保留时间（分钟），过期自动删除且不在图片库展示
YOLO_TEMP_TTL_MINUTES=60
# mask 只用于生成「识别图」；保存/展示的缩略图始终是原图直接裁切
YOLO_USE_MASK=true
# 识别图按 mask 抠成白底（关闭后识别也用原图裁切）
YOLO_MASK_CUTOUT=true
# 留空自动使用 mps（Apple Silicon）；也可显式写 cpu / mps
YOLO_DEVICE=

# ============ 其它 ============
# 开发调试 / 监听地址
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5555

# 是否在启动时自动建表 / 自动创建管理员（生产建议设为 false，改用 flask init-db）
AUTO_CREATE_DB=true
AUTO_BOOTSTRAP_ADMIN=true
# 是否由 Flask 直接托管 frontend/dist 静态文件（单机部署方便）
SERVE_FRONTEND=false
