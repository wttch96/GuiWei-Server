# ============ 基础配置 ============
# 生产环境务必修改
SECRET_KEY=please-change-me-to-a-random-string
JWT_SECRET=please-change-me-to-another-random-string
JWT_EXPIRES_HOURS=168

# SQLite 默认写入 backend/instance/guiwei.db，可改为其他 SQLAlchemy 连接串
# DATABASE_URL=sqlite:///E:/data/guiwei.db

# 上传目录（默认 backend/uploads）
# UPLOAD_FOLDER=E:/data/guiwei-uploads
MAX_UPLOAD_MB=20

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 管理员 ============
# 首次启动 / 执行 init-db 时，若库中没有管理员则用此账号创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ============ DeepSeek 对话模型 ============
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# 可用模型：deepseek-flash、deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0
AI_MAX_ITERATIONS=8

# ============ 视觉识图（DeepSeek 多模态） ============
# deepseek-flash 已支持图片输入，默认复用上面的 DEEPSEEK_API_BASE / DEEPSEEK_API_KEY。
# 一般只需填写 DEEPSEEK_API_KEY；如需使用其它 OpenAI 兼容视觉网关，再覆盖以下配置。
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=deepseek-flash
VISION_TIMEOUT=120

# ============ 其它 ============
# 开发调试 / 监听地址
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# 是否在启动时自动建表 / 自动创建管理员（生产建议设为 false，改用 flask init-db）
AUTO_CREATE_DB=true
AUTO_BOOTSTRAP_ADMIN=true
# 是否由 Flask 直接托管 frontend/dist 静态文件（单机部署方便）
SERVE_FRONTEND=false
